<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="E2E Suite" parallel="methods" thread-count="5">

<listeners>
	<listener class-name="webUtils.TestListeners"/>
</listeners>

  <test  name="Test">
  
  <groups>
		<run>
			<include name="OrderValidation"/>
		</run>
	</groups>
    <classes>
      <class name="E2ETestSuite.EcomTest.E2ETest">
	      <methods>
		      <include name="LoginTest"/>
		      <include name="homePageValidation"/>
		      <include name="addToCartValidation"/>
		      <include name="checkoutTest"/>
		      <include name="ordersValidation"/>
	      </methods>
      </class>
    </classes>
    
  </test> <!-- Test -->
</suite> <!-- Suite -->
